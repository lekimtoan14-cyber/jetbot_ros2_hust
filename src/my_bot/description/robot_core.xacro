<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="inertial_macros.xacro" />

    <material name="white">
        <color rgba="1 1 1 1" />
    </material>

    <material name="orange">
        <color rgba="1 0.3 0.1 1" /> 
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1" />
    </material>

    <material name="black">
        <color rgba="0 0 0 1" />
    </material>

    <material name="red">
        <color rgba="1 0 0 1" />
    </material>

    <link name="base_link">
    </link>


    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="-0.097 0 0"/>
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="0.07 0 0" /> 
            <geometry>
                <box size="0.14 0.12 0.035"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <origin xyz="0.07 0 0" /> 
            <geometry>
                <box size="0.14 0.12 0.035"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.25" x="0.14" y="0.12" z="0.035">
            <origin xyz="0.07 0 0" rpy="0 0 0" /> </xacro:inertial_box>
        
    </link>

    <gazebo reference="chassis">
        <material>Gazebo/Red</material>
    </gazebo>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 0.0675 0" rpy="${-pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.0325" length="0.015"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.0325" length="0.015"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.015" radius="0.0325"> <origin xyz="0 0 0" rpy="0 0 0" /> </xacro:inertial_cylinder>
    </link>

    
    <gazebo reference="left_wheel">
        <material>Gazebo/White</material>
    </gazebo>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 -0.0675 0" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.0325" length="0.015"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.0325" length="0.015"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.015" radius="0.0325"> <origin xyz="0 0 0" rpy="0 0 0" /> </xacro:inertial_cylinder>
    </link>    


    <gazebo reference="right_wheel">
        <material>Gazebo/White</material>
    </gazebo>  

    <joint name="caster_wheel_joint" type="fixed">
        <parent link="chassis"/>
        <child link="caster_wheel"/>
        <origin xyz="0.02 0 -0.0175"/>
    </joint>        

    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="0.015"/>
            </geometry>
            <material name="white"/>
        </visual>    
        <collision>
            <geometry>
                <sphere radius="0.015"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="0.1" radius="0.015">
            <origin xyz="0 0 0" rpy="0 0 0" /> </xacro:inertial_sphere>
    </link>
  
    <joint name="chassis_2_joint" type="fixed">
        <parent link="chassis"/>
        <child link="chassis_2"/>
        <origin xyz="0 0 0"/>
    </joint>

    <link name="chassis_2">
        <visual>
            <origin xyz="0.07 0 0.05" /> 
            <geometry>
                <box size="0.14 0.09 0.065"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0.07 0 0.05" /> 
            <geometry>
                <box size="0.14 0.09 0.065"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.2" x="0.14" y="0.09" z="0.065">
            <origin xyz="0.07 0 0.05" rpy="0 0 0" /> </xacro:inertial_box>
        
    </link>

    <joint name="chassis_3_joint" type="fixed">
        <parent link="chassis_2"/>
        <child link="chassis_3"/>
        <origin xyz="0 0 0"/>
    </joint>

    <link name="chassis_3">
        <visual>
            <origin xyz="0.07 0 0.1" /> 
            <geometry>
                <box size="0.08 0.06 0.035"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0.07 0 0.1" /> 
            <geometry>
                <box size="0.08 0.06 0.035"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.2" x="0.08" y="0.06" z="0.035">
            <origin xyz="0.07 0 0.1" rpy="0 0 0" /> </xacro:inertial_box>
        
    </link>


    <gazebo reference="chassis_2">
        <material>Gazebo/Blue</material>
    </gazebo>  
    <gazebo reference="chassis_3">
        <material>Gazebo/Black</material>
    </gazebo>  
    <gazebo reference="caster_wheel">
        <material>Gazebo/White</material>
        <mu1 value="0.001"/>
        <mu2 value="0.001"/>
    </gazebo>

</robot>